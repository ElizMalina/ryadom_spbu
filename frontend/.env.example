# Use HOME_API_MODE=demo ONLY for local UI demonstration.
HOME_API_MODE=demo
# For real integration, unset HOME_API_MODE and set the following:
# HOME_API_URL=http://localhost:8080
# HOME_API_PATH=/api/v1/home

# Go-backed local accounts, roles and submissions. Leave unset for the local demo.
# AUTH_API_BASE_URL=http://localhost:8080

# Use the same Go backend for the public article catalog and approved articles.
# PSYCHO_API_MODE=backend
# PSYCHO_API_BASE_URL=http://localhost:8080
